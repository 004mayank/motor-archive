# This hosted preview uses Sites + Vinext + D1. See README for architecture differences.
# For local Cloudflare bindings, copy the appropriate settings into ignored .dev.vars.
# Samples are always labelled. Set live to exclude every sample edition and stop sample seeding.
CONTENT_MODE=sample
# Required for editorial writes. Comma-separated authenticated email allowlist; deny by default.
ADMIN_EMAILS=
# Live research provider (Tavily documented Search API).
TAVILY_API_KEY=
# OpenAI-compatible chat-completions provider. Never place keys in NEXT_PUBLIC variables.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# Resend and a verified sending domain, required for confirmation emails.
RESEND_API_KEY=
EMAIL_FROM=
# External scheduler calls POST /api/cron using this bearer secret and a weekly idempotency key.
CRON_SECRET=
APP_ORIGIN=https://motor-archive.fynd-8655.chatgpt.site
# PostgreSQL/Prisma/Vercel are not connected in this Sites-hosted implementation.
# Do not add DATABASE_URL here expecting the D1 repository to switch adapters automatically.
